# Local dev defaults match docker-compose.yml; override for staging/prod.
DATABASE_URL=postgresql+psycopg://trustkaro:trustkaro@localhost:5432/trustkaro
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=

APIFY_TOKEN=
SERPAPI_KEY=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# provider is "anthropic" or "gemini" per call-site, independently swappable.
# Both default to gemini -- ANTHROPIC_API_KEY above is optional unless you flip one of these.
MODEL_EXTRACT_PROVIDER=gemini
MODEL_EXTRACT=gemini-3.1-flash-lite
MODEL_SYNTH_PROVIDER=gemini
MODEL_SYNTH=gemini-3.1-flash-lite

# Reddit script app (free): reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trustkaro-ingestion/0.1

META_AD_LIBRARY_TOKEN=

# long random string; protects /admin endpoints
ADMIN_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

WHOISXML_KEY=
SENTRY_DSN=

BASE_URL=http://localhost:8000

# In prod, set to your web domain: https://trustkaro.in
CORS_ORIGINS=*

# follow-up survey delay; 17280 = 12 days (spec). Use 2 to test the loop.
FOLLOWUP_DELAY_MINUTES=17280

# private beta allowlist (comma-separated TG user ids); empty = open to all
BOT_ALLOWLIST=
MAX_COLD_CHECKS_PER_DAY=200
# PII vision calls (payment screenshots) — must be paid-tier/Anthropic in prod
MODEL_PII_PROVIDER=anthropic
MODEL_PII=claude-haiku-4-5
